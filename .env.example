# Copie este archivo como .env y ajuste los valores a su instalación de PostgreSQL
PORT=3000
# Base de trabajo (la que usa la aplicación)
DATABASE_URL=postgresql://practicas_app:CAMBIAR_CLAVE@localhost:5432/practicas
# Base exclusiva para las pruebas: 'npm test' la reinicia. Su nombre DEBE terminar en _test
TEST_DATABASE_URL=postgresql://practicas_app:CAMBIAR_CLAVE@localhost:5432/practicas_test
